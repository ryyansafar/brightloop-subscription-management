DATABASE_URL="file:./dev.db"
# Filled in by `npm run setup:env` (random, at least 32 characters). Never commit the real value.
AUTH_SESSION_SECRET=
APP_ORIGIN=http://localhost:3000
# Header identities work only under NODE_ENV=test. Keep 0 for the demo.
AUTH_DEV_BYPASS=0
# Set resend and a private API key. This test sender reaches only your Resend account email.
# Replace it with an address on your verified domain to reach other recipients.
# Leave disabled until your provider account is ready. No live mail is sent by default.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Optional local-only password reset preview (never enabled in production).
AUTH_DEV_MAILER=0
# Public deployments must configure an ingress-overwritten single-client-IP header.
AUTH_TRUSTED_IP_HEADER=
# New public accounts must prove email ownership before receiving a session.
AUTH_REQUIRE_EMAIL_VERIFICATION=1
